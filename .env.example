# ============================================================================
# TestingBuddy — SF QA Requirement Intelligence Platform
# Local development environment variables. Copy to .env and fill in values.
# .env is gitignored. .env.example is committed.
# ============================================================================

# --- General -----------------------------------------------------------------
APP_ENV=local                  # local | dev | staging | prod
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
APP_SECRET_KEY=change-me-dev-only-not-for-production
# Comma-separated browser origins allowed by CORS (the web dev server).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database ----------------------------------------------------------------
# Host port 5433 avoids clashing with a natively-installed PostgreSQL on 5432.
# The app connects as the RLS-subject role sfqa_app; migrations use sfqa (super).
DATABASE_URL=postgresql+asyncpg://sfqa_app:sfqa_app_dev_only@localhost:5433/sfqa
MIGRATION_DATABASE_URL=postgresql+asyncpg://sfqa:sfqa_dev_only@localhost:5433/sfqa

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible) ------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sfqa_minio
S3_SECRET_KEY=sfqa_minio_dev_only
S3_BUCKET_EXPORTS=sfqa-exports

# --- Auth (OIDC) -------------------------------------------------------------
# AUTH_PROVIDER=dev uses an in-process fake JWT issuer for local development.
# Switch to AUTH_PROVIDER=oidc and set OIDC_* for real IdP integration.
AUTH_PROVIDER=dev              # dev | oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
DEV_AUTH_SHARED_SECRET=dev-only-not-for-production

# --- AI provider (LLM) -------------------------------------------------------
# AI_PROVIDER=stub returns deterministic canned responses. Use for tests and
# offline development. AI_PROVIDER=anthropic uses the Anthropic API.
AI_PROVIDER=stub               # stub | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-opus-4-5         # adjust to current latest
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5          # adjust to current latest

# --- AI provider (embeddings) ------------------------------------------------
EMBEDDINGS_PROVIDER=stub       # stub | openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Jira --------------------------------------------------------------------
# JIRA_PROVIDER=stub returns a small canned issue corpus for development.
JIRA_PROVIDER=stub             # stub | cloud

# --- KMS / secrets envelope encryption ---------------------------------------
# In production this is an AWS KMS / GCP KMS CMK alias. In dev we use a static
# key — never use this value in any non-local environment.
KMS_PROVIDER=local             # local | aws | gcp
KMS_LOCAL_MASTER_KEY=dev-only-32-bytes-base64-fake-key-do-not-use-in-prod==

# --- Cost guardrails ---------------------------------------------------------
# Per-tenant monthly token budget (USD cents). Enforced at ai_client boundary.
DEFAULT_TENANT_MONTHLY_BUDGET_CENTS=2000

# --- Feature flags -----------------------------------------------------------
FEATURE_CHANGE_INTELLIGENCE=false
FEATURE_PROMPT_CACHE=false
